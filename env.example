# Runtime ENV defaults. In Fibe, these are editable after launch from the
# playground service ENV editor and apply after recreating the app.
APP_ALLOWED_HOSTS=*
APP_ALLOW_PRIVATE_MONITOR_URLS=false
APP_ASSUME_HTTPS=false
APP_COOKIE_SAMESITE=lax
APP_COOKIE_SECURE=auto
APP_CORS_ALLOWED_ORIGINS=*
APP_CSP_CONNECT_SRC=
APP_CSP_MODE=off
APP_ENV=development
APP_FORCE_HTTPS=false
APP_FRAME_ANCESTORS=
APP_HSTS=false
APP_PORT=3000
APP_PUBLIC_ORIGIN=
APP_SECRET=dev-secret-change-me
APP_TRUST_PROXY_HEADERS=true
APP_X_FRAME_OPTIONS=
CARGO_BUILD_JOBS=1
DATABASE_URL=postgres://postgres:password@localhost:5432/uptime_console
DB_ACQUIRE_TIMEOUT_MS=1500
DB_MAX_CONNECTIONS=5
DB_MIN_CONNECTIONS=0
FRONTEND_CPUS=0.50
FRONTEND_MEM_LIMIT=384m
PUBLIC_DEMO_PASSWORD=password
REDIS_URL=redis://localhost:6379/0
RUST_LOG=info,tower_http=info
SETUP_CPUS=1.00
SETUP_MEM_LIMIT=1024m
VITE_ALLOWED_HOSTS=true
VITE_API_ORIGIN=http://localhost:3000
VITE_USE_POLLING=false
WEB_CPUS=1.00
WEB_MEM_LIMIT=1024m
WORKER_CPUS=0.75
WORKER_MEM_LIMIT=768m
